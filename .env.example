# Copy to .env. The free-model profile below needs only a free OpenRouter key
# (https://openrouter.ai/keys). Gemma free models often answer 429 (shared provider limit),
# nemotron worked reliably. Free models allow ~50 requests per day per account,
# and one chat message makes 3 model calls.
OPENROUTER_API_KEY=
SECRET_KEY=change-me-to-a-long-random-string

ROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
EXTRACTOR_MODEL=nvidia/nemotron-3.5-super-vl:free
FORMATTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# false: no paid web search, store links are search-page templates
SHOP_SEARCH_ENABLED=false

# Overridden by compose for the containers; used for local runs (uv run ...)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/literature
# QDRANT_HOST=localhost
